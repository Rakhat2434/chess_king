# MongoDB connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chessking?retryWrites=true&w=majority

# NextAuth.
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
NEXTAUTH_URL=http://localhost:3000

# Cloudinary. API key and secret are server-side only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Admin seed credentials. Use a strong password and keep values private.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-admin-password>
SEED_SECRET=<long-random-seed-secret>

# Public site and social links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/<phone-number>
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/<profile>

# SMTP email notifications.
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM="ChessKing <no-reply@example.com>"
